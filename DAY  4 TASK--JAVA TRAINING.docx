3.Find the sum of numbers from 1 to 100. 

public class main {
    public static void main(String[] args) {
        int sum = 0;

        for (int i = 1; i <= 100; i++) {
            sum = sum + i;
        }

        System.out.println("Sum: " + sum);
    }
}

