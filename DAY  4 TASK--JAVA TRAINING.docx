----------------------------------------------> WHILE LOOP

1. Print Numbers from 1 to 20 Using While Loop

public class Main {
    public static void main(String[] args) {
        int i = 1;

        while (i <= 20) {
            System.out.println(i);
            i++;
        }
    }
}
