8.	Calculate the sum of all even numbers from 1 to N. 
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter N: ");
        int n = sc.nextInt();

        int sum = 0;

        for (int i = 2; i <= n; i += 2) {
            sum = sum + i;
        }
        System.out.println("Sum: " + sum);
    }
}
